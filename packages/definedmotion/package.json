{
  "name": "definedmotion",
  "version": "0.4.0-alpha.0",
  "description": "Programmatic 2D and 3D animation runtime, Studio, and agent reference",
  "author": "Hugo Olsson",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoOlsson/DefinedMotion.git"
  },
  "type": "module",
  "bin": {
    "definedmotion": "cli/index.mjs"
  },
  "types": "./src/public/index.ts",
  "exports": {
    ".": "./src/public/index.ts",
    "./animation": "./src/public/animation.ts",
    "./assets": "./src/public/assets.ts",
    "./latex": "./src/public/latex.ts",
    "./math": "./src/public/math.ts",
    "./media": "./src/public/media.ts",
    "./rendering": "./src/public/rendering.ts",
    "./reference": "./src/public/reference.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "cli",
    "resources",
    "src",
    "reference",
    "AGENTS.md",
    "README.md",
    "electron.vite.config.ts",
    "svelte.config.mjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node ./cli/index.mjs build --project ../../playground",
    "dev": "node ./cli/index.mjs dev --project ../../playground",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "pack:check": "node ./scripts/verify-pack.mjs",
    "reference:generate": "node ./scripts/generate-reference.mjs",
    "reference:verify": "node ./scripts/verify-reference.mjs",
    "prepack": "npm run reference:generate && npm run reference:verify",
    "test:automation": "node ./scripts/automation-smoke-test.mjs",
    "test:runtime-session": "node ./scripts/runtime-session-smoke-test.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.3",
    "alea": "^1.0.1",
    "electron": "^35.0.3",
    "electron-store": "^8.2.0",
    "electron-vite": "^3.1.0",
    "mathjax-full": "^3.2.2",
    "svelte": "^5.25.3",
    "tailwindcss": "^4.1.3",
    "three.meshline": "^1.4.0",
    "troika-three-text": "^0.52.4",
    "vite": "^6.2.3",
    "vite-plugin-glsl": "^1.4.0"
  },
  "peerDependencies": {
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.13.13",
    "@types/three": "^0.175.0",
    "eslint": "^9.23.0",
    "eslint-plugin-svelte": "^2.46.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "sharp": "^0.34.1",
    "svelte-check": "^4.1.5",
    "three": "^0.175.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "definedmotion",
    "animation",
    "three.js",
    "motion-graphics"
  ]
}
