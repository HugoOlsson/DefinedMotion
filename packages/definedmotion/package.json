{
  "name": "definedmotion",
  "version": "0.4.0-alpha.11",
  "description": "Programmatic 2D and 3D animation runtime, Studio, and agent reference",
  "author": "Hugo Olsson",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoOlsson/DefinedMotion.git"
  },
  "type": "module",
  "bin": {
    "definedmotion": "cli/index.mjs"
  },
  "types": "./types/public/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/public/index.d.ts",
      "default": "./src/public/index.ts"
    },
    "./animation": {
      "types": "./types/public/animation.d.ts",
      "default": "./src/public/animation.ts"
    },
    "./assets": {
      "types": "./types/public/assets.d.ts",
      "default": "./src/public/assets.ts"
    },
    "./latex": {
      "types": "./types/public/latex.d.ts",
      "default": "./src/public/latex.ts"
    },
    "./math": {
      "types": "./types/public/math.d.ts",
      "default": "./src/public/math.ts"
    },
    "./media": {
      "types": "./types/public/media.d.ts",
      "default": "./src/public/media.ts"
    },
    "./rendering": {
      "types": "./types/public/rendering.d.ts",
      "default": "./src/public/rendering.ts"
    },
    "./reference": {
      "types": "./types/public/reference.d.ts",
      "default": "./src/public/reference.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "cli",
    "resources",
    "src",
    "types",
    "reference",
    "!reference/**/.DS_Store",
    "AGENTS.md",
    "README.md",
    "electron.vite.config.ts",
    "svelte.config.mjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node ./cli/index.mjs build --project ../../playground",
    "dev": "node ./cli/index.mjs dev --project ../../playground",
    "test": "npm run test:positioning",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "types:generate": "node ./scripts/generate-types.mjs",
    "pack:check": "npm run test:positioning && npm run types:generate && node ./scripts/verify-pack.mjs",
    "reference:generate": "node ./scripts/generate-reference.mjs",
    "reference:verify": "node ./scripts/verify-reference.mjs",
    "prepack": "npm run test:positioning && npm run reference:generate && npm run reference:verify && npm run types:generate",
    "test:automation": "node ./scripts/automation-smoke-test.mjs",
    "test:positioning": "node ./scripts/positioning-test.mjs",
    "test:viewport-scheduler": "node ./scripts/interactive-viewport-scheduler-test.mjs",
    "test:runtime-session": "node ./scripts/runtime-session-smoke-test.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.3",
    "alea": "^1.0.1",
    "electron": "^35.0.3",
    "electron-store": "^8.2.0",
    "electron-vite": "^3.1.0",
    "mathjax-full": "^3.2.2",
    "svelte": "^5.25.3",
    "tailwindcss": "^4.1.3",
    "three.meshline": "^1.4.0",
    "troika-three-text": "^0.52.4",
    "vite": "^6.2.3",
    "vite-plugin-glsl": "^1.4.0"
  },
  "peerDependencies": {
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.13.13",
    "@types/three": "^0.175.0",
    "eslint": "^9.23.0",
    "eslint-plugin-svelte": "^2.46.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "sharp": "^0.34.1",
    "svelte-check": "^4.1.5",
    "three": "^0.175.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "definedmotion",
    "animation",
    "three.js",
    "motion-graphics"
  ]
}
